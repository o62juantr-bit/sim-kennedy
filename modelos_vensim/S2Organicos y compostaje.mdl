{UTF-8}
Fertilidad del suelo  = A FUNCTION OF( Mejora de fertilidad) ~~|
Fertilidad del suelo = INTEG(Mejora de fertilidad - FLO23 Extraccion de fertilidad, 0.5\
		)
	~	Dmnl
	~	Stock. Sube con compost, baja con extraccion. R1.
	|

Compost maduro  = A FUNCTION OF( Maduracion del compost) ~~|
Compost maduro = INTEG(Maduracion del compost - FLO12 Compost entregado a huertas, 0)
	~	kg
	~	Stock. Graficas G9.
	|

Organicos en la estacion  = A FUNCTION OF( Organicos recibidos por desvio) ~~|
Organicos en la estacion = INTEG(Organicos recibidos por desvio - Procesado a compost\
		 - FLO13 Sustrato al distrito de hongos
, 0)
	~	t
	~	Stock. En la tabla esta en kg; aqui en toneladas para coincidir con FLI07 \
		en t/semana. Graficas G12.
	|

Inventario de proteina de hongos  = A FUNCTION OF( Hongos frescos) ~~|
Inventario de proteina de hongos = INTEG(Hongos frescos - Venta de hongos - FLO15 Merma de hongos\
		, 0)
	~	kg
	~	Stock. Grafica G11.
	|

Organicos que salen del barrio acumulado = INTEG(Organicos por la ruta actual, 0)
	~	t
	~	Stock. Ruta actual.
	|

Generacion de organicos = Organicos per capita*Poblacion Kennedy*7/1000
	~	t/Week
	~	Auxiliar. Grafica G8. 2.571 t/semana (367 t/dia).
	|

Organicos recibidos por desvio = MIN(Fraccion desviada*Generacion de organicos,Capacidad de la estacion\
		)
	~	t/Week
	~	Flujo. Graficas G8, G10. MIN(PAR08 x generacion, PAR14).
	|

Organicos por la ruta actual = Generacion de organicos-Organicos recibidos por desvio
	~	t/Week
	~	Flujo. Grafica G8.
	|

Procesado a compost = Organicos en la estacion*(1-Fraccion de sustrato al distrito*Fraccion del organico apta como sustrato\
		)/Tiempo de proceso en estacion
	~	t/Week
	~	Flujo. Flujo agregado para cerrar el stock (no esta en la tabla).
	|

Sustrato al distrito de hongos = Organicos en la estacion*Fraccion de sustrato al distrito\
		*Fraccion del organico apta como sustrato/Tiempo de proceso en estacion
	~	t/Week
	~	Flujo. Solo con control de calidad. B 2%, C 5%.
	|

Maduracion del compost = DELAY3(Procesado a compost*1000*Compost por kg de organico,Retardo de maduracion tau\
		)
	~	kg/Week
	~	Flujo. Grafica G9. Madurado(t) = K14 x procesado(t - tau).
	|

Compost entregado a huertas = MIN(Compost maduro/TIME STEP,Compost maximo absorbible*\
		1000)
	~	kg/Week
	~	Flujo. Graficas G9. MIN(maduro, STK01 x K13 / 52).
	|

Hongos frescos = Sustrato al distrito de hongos*1000*Fraccion seca del sustrato*Rendimiento biologico de hongos
	~	kg/Week
	~	Flujo. Grafica G11. Sustrato x K21 x K20.
	|

Venta de hongos = MIN(Demanda de hongos*Precio relativo de hongos,0.5*Inventario de proteina de hongos\
		/TIME STEP)
	~	kg/Week
	~	Flujo. Demanda x precio relativo.
	|

Merma de hongos = Inventario de proteina de hongos/Vida util de hongos
	~	kg/Week
	~	Flujo. STK09 / vida util.
	|

Mejora de fertilidad = (1-Fertilidad del suelo)*Coeficiente de mejora de fertilidad*MIN\
		(1,ZIDZ(Compost entregado a huertas*52,Area de huertas desde S1*Dosis de compost por m2\
		))
	~	Dmnl/Week
	~	Flujo. R1 (CL-39, hipotesis): compost entregado / dosis.
	|

Extraccion de fertilidad = Fertilidad del suelo*Tasa de extraccion de fertilidad
	~	Dmnl/Week
	~	Flujo. Baja con extraccion por cosecha.
	|

Ocupacion de la estacion = ZIDZ(Organicos en la estacion,Capacidad de la estacion*Tiempo de proceso en estacion\
		)
	~	Dmnl
	~	Auxiliar. Grafica G12. Si pasa de 1 el exceso sigue la ruta actual.
	|

Personas cuyo residuo se aprovecha = Organicos recibidos por desvio*1000/(Organicos per capita\
		*7)
	~	persona
	~	Auxiliar. Grafica G10.
	|

Retorno al suelo = ZIDZ(Compost entregado a huertas,Organicos recibidos por desvio*1000\
		)
	~	Dmnl
	~	Auxiliar. FLO12 / FLI07.
	|

Rendimiento efectivo con compost = Rendimiento por area*(1+Efecto de fertilidad sobre rendimiento\
		*(Fertilidad del suelo-0.5))
	~	kg/m2/Year
	~	Auxiliar. Cierra R1: el compost devuelve rendimiento a S1.
	|

Produccion de huertas con compost = Area de huertas desde S1*Rendimiento efectivo con compost\
		/52
	~	kg/Week
	~	Reportero de grafica. Referencia para S1.
	|

Generacion diaria = Organicos per capita*Poblacion Kennedy/1000
	~	t/Day
	~	Reportero de grafica. Grafica G8. 367,3 t/dia.
	|

Compost maximo absorbible = Area de huertas desde S1*Dosis de compost por m2/52/1000
	~	t/Week
	~	Reportero de grafica. Grafica G9. B 24,1 y C 51,9 t/semana.
	|

Organicos necesarios = Compost maximo absorbible/Compost por kg de organico
	~	t/Week
	~	Reportero de grafica. Grafica G9. B 48,2 y C 103,8 t/semana.
	|

Hongos frescos anuales = Hongos frescos*52/1000
	~	t/Year
	~	Reportero de grafica. Grafica G11. Techo con PAR16 = 1.
	|

Escenario S2 = 2
	~	Dmnl
	~	Parametro o constante. 1 = A ruta actual, 2 = B compostaje comunitario \
		E10, 3 = C compostaje en Bavaria Comun.
	|

Poblacion Kennedy = 1.03429e+06
	~	persona
	~	Parametro o constante. V.
	|

Residuos en Doña Juana Bogota = 5600
	~	t/Day
	~	Parametro o constante. V Alcaldia 2026.
	|

Fraccion organica = 0.5
	~	Dmnl
	~	Parametro o constante. V mas del 50%.
	|

Poblacion Bogota = 7.88393e+06
	~	persona
	~	Parametro o constante. V, confirmar en DANE.
	|

Organicos per capita = Residuos en Doña Juana Bogota*Fraccion organica*1000/Poblacion Bogota
	~	kg/persona/Day
	~	Parametro o constante. D = K08 x K09 / K10 = 0,355.
	|

Dosis de compost por m2 = 10
	~	kg/m2/Year
	~	Parametro o constante. V externa La Habana.
	|

Compost por kg de organico = 0.5
	~	Dmnl
	~	Parametro o constante. S.
	|

Fraccion seca del sustrato = 0.3
	~	Dmnl
	~	Parametro o constante. S.
	|

Area de huertas desde S1 = IF THEN ELSE(Escenario S2=1,0,IF THEN ELSE(Escenario S2=2,\
		125309,269998))
	~	m2
	~	Parametro o constante. Entrada desde S1 (A 0, B 125.309, C 269.998).
	|

Rendimiento por area = 6
	~	kg/m2/Year
	~	Parametro o constante. 1, 3, 6 o 12.
	|

Fraccion desviada = IF THEN ELSE(Escenario S2=1,0,IF THEN ELSE(Escenario S2=2,0.02,0.05\
		))
	~	Dmnl
	~	Parametro o constante. Slider 0 a 0,6. G8 usa 0,02 (S).
	|

Rendimiento biologico de hongos = 0.45
	~	Dmnl
	~	Parametro o constante. = K20, rango 0,25 a 0,65.
	|

Capacidad de la estacion = IF THEN ELSE(Escenario S2=1,0,IF THEN ELSE(Escenario S2=2,\
		20,80))
	~	t/Week
	~	Parametro o constante. Por definir (S).
	|

Fraccion del organico apta como sustrato = 1
	~	Dmnl
	~	Parametro o constante. Por definir. 1 = techo teorico.
	|

Fraccion de sustrato al distrito = IF THEN ELSE(Escenario S2=2,0.02,IF THEN ELSE(Escenario S2\
		=3,0.05,0))
	~	Dmnl
	~	Parametro o constante. B 2%, C 5%.
	|

Tiempo de proceso en estacion = 4
	~	Week
	~	Parametro o constante. S.
	|

Retardo de maduracion tau = 12
	~	Week
	~	Parametro o constante. S.
	|

Demanda de hongos = 1500
	~	kg/Week
	~	Parametro o constante. S.
	|

Precio relativo de hongos = 1
	~	Dmnl
	~	Parametro o constante. S.
	|

Vida util de hongos = 2
	~	Week
	~	Parametro o constante. S.
	|

Coeficiente de mejora de fertilidad = 0.01
	~	1/Week
	~	Parametro o constante. S.
	|

Tasa de extraccion de fertilidad = 0.003
	~	1/Week
	~	Parametro o constante. S.
	|

Efecto de fertilidad sobre rendimiento = 0.5
	~	Dmnl
	~	Parametro o constante. S.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 520
	~	Week
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Week
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Week [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Week [0,?]
	~	The time step for the simulation.
	|

