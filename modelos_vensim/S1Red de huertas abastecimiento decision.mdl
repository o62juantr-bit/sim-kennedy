{UTF-8}
STK01 Huertas activas  = A FUNCTION OF( -Area meta,FLI01 Apertura de huertas) ~~|
STK01 Huertas activas = INTEG(FLI01 Apertura de huertas - FLO01 Cierre de huertas, 0.02\
		*Area meta)
	~	m2
	~	Stock. Graficas G1, G2, G5, G7. Valor inicial = 2% del area meta del \
		escenario. La tabla da el area meta: A 0, B 125.309, C 269.998 m2.
	|

Producto en acopio  = A FUNCTION OF( Excedente al acopio,-Compras locales) ~~|
Producto en acopio = INTEG(Excedente al acopio - Compras locales - FLO06 Venta en feria\
		 - FLO07 Merma en acopio
, 100)
	~	kg
	~	Stock. Bucle B4. Valor inicial 100 (S).
	|

Capacidad de acopio y reparto  = A FUNCTION OF( Ampliacion de acopio) ~~|
Capacidad de acopio y reparto = INTEG(Ampliacion de acopio - Desgaste del equipamiento\
		, 5000)
	~	kg/Week
	~	Stock. Maximo que maneja el equipo rotativo N-08. Valor inicial por \
		estimar (S).
	|

Promotores activos  = A FUNCTION OF( Formacion de promotores) ~~|
Promotores activos = INTEG(Formacion de promotores - Retiro de promotores, 6)
	~	persona
	~	Stock. Formados en Bavaria N-21. Bucles R3 y B5. Valor inicial 6 (S).
	|

Cosecha disponible  = A FUNCTION OF( Produccion) ~~|
Cosecha disponible = INTEG(Produccion - FLO02 Autoconsumo - Excedente al acopio - FLO04 Merma en huerta
, 300)
	~	kg
	~	Stock. Grafica G1. Valor inicial 300 (S).
	|

Ingreso acumulado  = A FUNCTION OF( Ingreso por ventas,-Reinversión) ~~|
Ingreso acumulado = INTEG(Ingreso por ventas - Reinversion, 100000)
	~	COP
	~	Stock. Caja de la red. Valor inicial 100.000 (S).
	|

Participantes activos  = A FUNCTION OF( -Area meta,Incorporacion de participantes,-m2 por huertero\
		) ~~|
Participantes activos = INTEG(Incorporacion de participantes - FLO09 Retiro de participantes\
		, 0.02*Area meta
/m2 por huertero)
	~	persona
	~	Stock. Graficas G4, G7. El valor de la tabla (B 2.506, C 5.400) es el \
		techo N de adopcion; aqui se parte del 2% del techo.
	|

Solicitudes decididas  = A FUNCTION OF( Capacidad de decision mu,Solicitudes pendientes\
		,TIME STEP) ~~|
Solicitudes decididas = MIN(Capacidad de decision mu,ZIDZ(Solicitudes pendientes,TIME STEP\
		)+FLI11 Llegada de solicitudes
)
	~	solicitud/Week
	~	Flujo. Central: mu c. Rotativo: asambleas x mu a x (1 - perdida por \
		relevo). Escenario A sin decision.
	|

Solicitudes pendientes  = A FUNCTION OF( Llegada de solicitudes) ~~|
Solicitudes pendientes = INTEG(Llegada de solicitudes - FLO18 Solicitudes decididas, \
		0)
	~	solicitud
	~	Stock. Cola de pedidos sobre cupos, suelo, acopio o presupuesto. Grafica \
		G6.
	|

Conocimiento compartido  = A FUNCTION OF( Formacion e intercambio de semillas) ~~|
Conocimiento compartido = INTEG(Formacion e intercambio de semillas - Perdida de conocimiento\
		, 0.1)
	~	Dmnl
	~	Stock. Indice 0 a 1. Bucle R2. Valor inicial 0,10 (S).
	|

Ampliacion de acopio  = A FUNCTION OF( Costo por kg semana de capacidad,Presupuesto publico\
		,Fraccion de presupuesto a acopio,Fraccion de reinversion a capacidad,Reinversión)\
		 ~~|
Ampliacion de acopio = (Reinversion*Fraccion de reinversion a capacidad+Presupuesto publico\
		/52*Fraccion de presupuesto a acopio
)/Costo por kg semana de capacidad
	~	kg/Week/Week
	~	Flujo. Reinversion FLO10 y parte del presupuesto publico EXO03. Bucle R1.
	|

Incorporacion de participantes  = A FUNCTION OF( Adopcion espontanea efectiva,Bass q,\
		Retardo de aprendizaje,Techo de huerteros N) ~~|
Incorporacion de participantes = SMOOTH(MAX(0,(Adopcion espontanea efectiva+Bass q*ZIDZ\
		(STK05 Participantes activos
,Techo de huerteros N))*(Techo de huerteros N-STK05 Participantes activos)),Retardo de aprendizaje\
		*4.33)
	~	persona/Week
	~	Flujo. Grafica G4. Difusion tipo Bass con retardo de aprendizaje PAR07 \
		(meses a semanas x 4,33).
	|

Reinversión  = A FUNCTION OF( Fraccion reinvertida)
	~	
	~		|

FLI01 Apertura de huertas = Promotores activos*m2 abiertos por promotor*Disponibilidad de suelo\
		*AUX08 Calidad de manejo*Efecto conocimiento sobre apertura*Efecto de la norma de ronda\
		*Efecto de cola de decision*Margen de crecimiento*Efecto de participantes disponibles
	~	m2/Week
	~	Flujo. Tabla: STK11 x m2 por promotor x AUX01 x AUX08 x norma de ronda. Se \
		agregan efecto del conocimiento STK07 (R2), de la cola de decision (P6) y \
		el margen hasta el area meta.
	|

Produccion = STK01 Huertas activas*PAR01 Rendimiento por area/52*Clima*AUX08 Calidad de manejo
	~	kg/Week
	~	Flujo. Grafica G1.
	|

Ingreso por ventas = (Compras locales+FLO06 Venta en feria)*Precio de excedentes*Precio mayorista base
	~	COP/Week
	~	Flujo. Tabla: (FLO05+FLO06) x PAR05. Se multiplica por el precio mayorista \
		base porque PAR05 es una razon.
	|

Formacion e intercambio de semillas = Encuentros por semana*Asistentes por encuentro*\
		Calidad del encuentro/Escala de formacion*(1-Conocimiento compartido)
	~	Dmnl/Week
	~	Flujo. Encuentros x asistentes x calidad, acotado por (1-STK07). Incluye \
		registros devueltos a Bavaria D13.
	|

Formacion de promotores = MIN(Cupos mensuales de formacion/4.33,Capacidad de formadores\
		)
	~	persona/Week
	~	Flujo. PAR11/4,3 limitado por formadores N-19.
	|

Llegada de solicitudes = Participantes activos*Solicitudes por participante
	~	solicitud/Week
	~	Flujo. Grafica G6 (tasa de llegada lambda).
	|

FLO01 Cierre de huertas = STK01 Huertas activas*Tasa de cierre
	~	m2/Week
	~	Flujo. Bucles B1 y B5.
	|

FLO02 Autoconsumo = Cosecha disponible*Autoconsumo/Tiempo de manejo
	~	kg/Week
	~	Flujo. Grafica G1.
	|

Excedente al acopio = MIN(Cosecha disponible*(1-Autoconsumo-Perdida en huerta)/Tiempo de manejo\
		,Capacidad de acopio y reparto)
	~	kg/Week
	~	Flujo. Grafica G1. Limitado por STK04.
	|

Merma en huerta = Cosecha disponible*Perdida en huerta/Tiempo de manejo
	~	kg/Week
	~	Flujo. Grafica G1.
	|

Compras locales = MIN(MIN(Demanda local efectiva,Capacidad de acopio y reparto),0.75*\
		Producto en acopio/TIME STEP)
	~	kg/Week
	~	Flujo. Tabla: MIN(EXO02, capacidad de reparto, STK03). Demanda corregida \
		por precio relativo frente a Corabastos (B2).
	|

FLO06 Venta en feria = MIN(Asistentes a feria*kg por visita,0.15*Producto en acopio/TIME STEP\
		)
	~	kg/Week
	~	Flujo. Asistentes x kg por visita, limitado por STK03.
	|

Merma en acopio = MIN(Producto en acopio*Perdida base en acopio*(1+3*Saturacion del acopio\
		),0.1*Producto en acopio/TIME STEP)
	~	kg/Week
	~	Flujo. Sube cuando STK03 supera STK04. Bucle B4.
	|

Desgaste del equipamiento = Capacidad de acopio y reparto*Depreciacion de equipamiento
	~	kg/Week/Week
	~	Flujo. STK04 x depreciacion.
	|

Retiro de participantes = Participantes activos*Tasa de retiro h
	~	persona/Week
	~	Flujo. Grafica G7. Bucle B1.
	|

Perdida de conocimiento = Conocimiento compartido*(Olvido semanal+Perdida de saber por relevo\
		)*(1-gamma Efecto de cultivos nativos*Area con cultivos nativos IPV1)
	~	Dmnl/Week
	~	Flujo. STK07 x (olvido + relevo PAR10) x (1 - gamma x AUX17).
	|

Retiro de promotores = Promotores activos*Tasa de retiro de promotores
	~	persona/Week
	~	Flujo. STK11 x tasa de retiro.
	|

Disponibilidad de suelo = Fraccion de suelo con acuerdo*(1-Revocacion por valorizacion\
		)
	~	Dmnl
	~	Auxiliar. Parte del suelo candidato (K17, K18) con acuerdo de uso. Estres \
		de valorizacion del suelo = REV.
	|

Dependencia de Corabastos en la zona = MAX(0,1-(Compras locales+FLO06 Venta en feria)\
		/Demanda de la zona)
	~	Dmnl
	~	Auxiliar. Grafica G3. Variable que mide el problema P1. Demanda de la zona \
		= poblacion x K05 x 7.
	|

Dependencia en Kennedy completa = MAX(0,1-Personas alimentadas/Poblacion Kennedy)
	~	Dmnl
	~	Auxiliar. Grafica G3. B 0,996 y C 0,991 en el area meta.
	|

Rotacion efectiva de vocerias = 3/Periodo de rotacion de vocerias
	~	relevo/Quarter
	~	Parametro o constante. Relevos por trimestre. Alivia la carga (B1).
	|

Carga por participante = ZIDZ(STK01 Huertas activas*Horas por m2 por semana,Participantes activos\
		*Horas disponibles por semana*(1+Alivio por rotacion*Rotacion efectiva de vocerias)\
		)
	~	Dmnl
	~	Auxiliar. Grafica G7. Horas requeridas / disponibles. Bucle B1.
	|

m2 por promotor = ZIDZ(STK01 Huertas activas,Promotores activos)
	~	m2/persona
	~	Auxiliar. Grafica G5. Bucle B5.
	|

AUX08 Calidad de manejo = MIN(1,XIDZ(Capacidad por promotor,m2 por promotor,1))
	~	Dmnl
	~	Auxiliar. Grafica G5. MIN(1, capacidad del promotor / AUX07).
	|

Tiempo medio de decision = XIDZ(Solicitudes pendientes,Solicitudes decididas,52)
	~	Week
	~	Auxiliar. Grafica G6. Ley de Little.
	|

Personas alimentadas = STK01 Huertas activas*PAR01 Rendimiento por area*(1-Perdida en huerta\
		)/(Cuota de frutas y verduras*365)
	~	persona
	~	Auxiliar. Graficas G2, G3. B 4.377 y C 9.431 con r = 6 en el area meta.
	|

Alcance de Bavaria sobre cada tipologia = EXP(-d Distancia a Bavaria/d0 Escala de alcance\
		)
	~	Dmnl
	~	Auxiliar. exp(-d/d0) con d por calles desde el nodo mas cercano.
	|

Area con cultivos nativos IPV1 = IF THEN ELSE(Escenario=1,0,IF THEN ELSE(Escenario=2,\
		0.1,0.2))
	~	Dmnl
	~	Parametro o constante. Indicador patrimonial. B 0,10 y C 0,20 (S).
	|

Escenario = 2
	~	Dmnl
	~	Parametro o constante. Selector: 1 = A sin intervencion, 2 = B nodo unico \
		y decision central, 3 = C cluster y decision rotativa.
	|

Alcance lotes = IF THEN ELSE(Escenario=1,0,IF THEN ELSE(Escenario=2,0.4,0.8))
	~	Dmnl
	~	Parametro o constante. Linea base: A 0, B 0,4, C 0,8 (S).
	|

Alcance techos = IF THEN ELSE(Escenario=1,0,IF THEN ELSE(Escenario=2,0.2,0.6))
	~	Dmnl
	~	Parametro o constante. Linea base: A 0, B 0,2, C 0,6 (S).
	|

Predio Bavaria incluido = IF THEN ELSE(Escenario=1,0,1)
	~	Dmnl
	~	Parametro o constante. No en A, si en B y C.
	|

Area meta = Predio Bavaria incluido*Predio Bavaria+Lotes baldios*Alcance lotes+Techos estrategia\
		*Fraccion de techo utilizable*Alcance techos
	~	m2
	~	Auxiliar. Formula 1 de la linea base. A 0, B 125.309, C 269.998 m2.
	|

Techo de huerteros N = MIN(Area meta/m2 por huertero,Hogares Kennedy*Alcance de Bavaria sobre cada tipologia\
		)
	~	persona
	~	Auxiliar. Grafica G4. B 2.506, C 5.400.
	|

Margen de crecimiento = IF THEN ELSE(Area meta>0,MAX(0,1-ZIDZ(STK01 Huertas activas,Area meta\
		)),0)
	~	Dmnl
	~	Auxiliar. Frena la apertura al llegar al area meta del escenario.
	|

Efecto de participantes disponibles = MAX(0,MIN(1,2-ZIDZ(STK01 Huertas activas,Participantes activos\
		*m2 por huertero)))
	~	Dmnl
	~	Auxiliar. R1/R3: solo se abre area si hay participantes que la cultiven \
		(area por huertero K15).
	|

Efecto conocimiento sobre apertura = 0.5+Conocimiento compartido
	~	Dmnl
	~	Auxiliar. R2: mas conocimiento, mas aperturas.
	|

Efecto de cola de decision = 1/(1+Tiempo medio de decision/Espera tolerable de decision\
		)
	~	Dmnl
	~	Auxiliar. Gobernanza P6: una cola larga frena aperturas.
	|

Tasa de cierre = Tasa base de cierre*(1+MAX(0,Carga por participante-1)+(1-AUX08 Calidad de manejo\
		))
	~	1/Week
	~	Auxiliar. Sube con AUX05 y con AUX07 via AUX08.
	|

Saturacion del acopio = MAX(0,ZIDZ(Producto en acopio,Capacidad de acopio y reparto)-\
		1)
	~	Dmnl
	~	Auxiliar. B4: STK03 por encima de STK04.
	|

Demanda local efectiva = Demanda de tiendas y comedores*Efecto de precio relativo
	~	kg/Week
	~	Auxiliar. Demanda de tiendas corregida por precio.
	|

Efecto de precio relativo = MAX(0,MIN(1,1-2*(Precio relativo local-1)))
	~	Dmnl
	~	Auxiliar. B2: si el precio local queda por encima del de Corabastos cae la \
		compra local.
	|

Precio relativo local = Precio de excedentes*Precio mayorista base/Precio Corabastos
	~	Dmnl
	~	Auxiliar. Precio local / precio de Corabastos.
	|

Precio Corabastos = Precio mayorista base*(1-Baja de precio de la central)
	~	COP/kg
	~	Auxiliar.
	|

Baja de precio de la central = Reaccion de precio de Corabastos*(1-Dependencia percibida por la central\
		)
	~	Dmnl
	~	Auxiliar. EXO05 x (1 - dependencia percibida).
	|

Dependencia percibida por la central = SMOOTHI(Dependencia de Corabastos en la zona,Retardo de reaccion de la central\
		,1)
	~	Dmnl
	~	Auxiliar. Retardo del bucle B2 (evita lazo algebraico).
	|

Demanda de la zona = Poblacion de la zona de servicio*Cuota de frutas y verduras*7
	~	kg/Week
	~	Auxiliar. Poblacion de la zona x K05 x 7.
	|

Adopcion espontanea efectiva = Bass p*Alcance de Bavaria sobre cada tipologia*(1+Conocimiento compartido\
		)
	~	1/Week
	~	Auxiliar. p de Bass ajustado por alcance de Bavaria y conocimiento.
	|

Perdida de saber por relevo = Fraccion de saber perdido por relevo/(Periodo de rotacion de vocerias\
		*4.33)
	~	1/Week
	~	Auxiliar. Relevo de vocerias segun PAR10.
	|

Perdida de capacidad por relevo = 0.5*(1-Conocimiento compartido)
	~	Dmnl
	~	Auxiliar. Rotar reparte la carga pero pierde conocimiento.
	|

Capacidad de decision mu = IF THEN ELSE(Escenario=2,mu c Capacidad central,IF THEN ELSE\
		(Escenario=3,Asambleas activas*mu a Capacidad por asamblea*(1-Perdida de capacidad por relevo\
		),0))
	~	solicitud/Week
	~	Reportero de grafica. Grafica G6. Central mu c. Rotativo asambleas x mu a \
		x (1 - perdida).
	|

Tasa de retiro h = MAX(0,h0 Retiro base*(1+beta Sensibilidad a la carga*(Carga por participante\
		-1)))
	~	1/Week
	~	Reportero de grafica. Grafica G7.
	|

Porcentaje de Kennedy = Personas alimentadas/Poblacion Kennedy*100
	~	Dmnl
	~	Reportero de grafica. Grafica G2.
	|

Poblacion de zona para dependencia 50 pct = 2*Personas alimentadas
	~	persona
	~	Reportero de grafica. Grafica G3. Zona donde la dependencia cae al 50%.
	|

Dependencia segun personas alimentadas = MAX(0,1-Personas alimentadas/Poblacion de la zona de servicio\
		)
	~	Dmnl
	~	Reportero de grafica. Grafica G3: formula AUX02 = max(0, 1 - AUX10 / \
		poblacion de la zona).
	|

Promotores necesarios = ZIDZ(STK01 Huertas activas,Capacidad por promotor)
	~	persona
	~	Reportero de grafica. Grafica G5.
	|

Poblacion Kennedy = 1.03429e+06
	~	persona
	~	Parametro o constante. V. Observatorio, DANE.
	|

Hogares Kennedy = 375508
	~	hogar
	~	Parametro o constante. V. DANE 2023.
	|

Cuota de frutas y verduras = 0.4
	~	kg/persona/Day
	~	Parametro o constante. V OMS. 146 kg al anio.
	|

m2 por huertero = 50
	~	m2/persona
	~	Parametro o constante. S. Patios de 40 a 80 m2.
	|

Fraccion de techo utilizable = 0.1
	~	Dmnl
	~	Parametro o constante. S. Verificar con catastro.
	|

Techos estrategia = 2.98617e+06
	~	m2
	~	Parametro o constante. D simulador.
	|

Lotes baldios = 63108
	~	m2
	~	Parametro o constante. D. Otra cifra 33.691: conciliar.
	|

Predio Bavaria = 40342
	~	m2
	~	Parametro o constante. D simulador.
	|

PAR01 Rendimiento por area = 6
	~	kg/m2/Year
	~	Parametro o constante. Slider 1, 3, 6 o 12. Sin dato de Bogota.
	|

Autoconsumo = 0.25
	~	Dmnl
	~	Parametro o constante. S.
	|

Perdida en huerta = 0.15
	~	Dmnl
	~	Parametro o constante. S.
	|

Precio de excedentes = 1
	~	Dmnl
	~	Parametro o constante. Razon al mayorista, 0,8 a 1,2.
	|

Fraccion reinvertida = 0.1
	~	Dmnl
	~	Parametro o constante. Por estimar.
	|

Retardo de aprendizaje = 6
	~	Month
	~	Parametro o constante. Por estimar.
	|

Periodo de rotacion de vocerias = 6
	~	Month
	~	Parametro o constante. Por definir con la Mesa.
	|

Cupos mensuales de formacion = 4
	~	persona/Month
	~	Parametro o constante. Por definir.
	|

Perdida base en acopio = 0.05
	~	1/Week
	~	Parametro o constante. Por definir.
	|

Clima = 1
	~	Dmnl
	~	Parametro o constante. Normal 1, lluvia 0,8, sequia 0,55 (S). Estres de \
		sequia.
	|

Demanda de tiendas y comedores = 15000
	~	kg/Week
	~	Parametro o constante. S. El simulador usa 150 tiendas.
	|

Presupuesto publico = 2e+07
	~	COP/Year
	~	Parametro o constante. Por estimar. Presupuestos participativos A34.
	|

Reaccion de precio de Corabastos = 0.15
	~	Dmnl
	~	Parametro o constante. 0 a 0,30 (S). Elasticidad del simulador 0,35.
	|

Poblacion de la zona de servicio = 20000
	~	persona
	~	Parametro o constante. Slider. Zona de ejemplo 20.000 personas (SDP por \
		completar).
	|

Fraccion de suelo con acuerdo = 0.6
	~	Dmnl
	~	Parametro o constante. S.
	|

Revocacion por valorizacion = 0
	~	Dmnl
	~	Parametro o constante. Estres: revocacion de baldios (antes SIM6).
	|

m2 abiertos por promotor = 20
	~	m2/Week/persona
	~	Parametro o constante. S.
	|

Capacidad por promotor = 1000
	~	m2/persona
	~	Parametro o constante. S. 20 huertas de 50 m2.
	|

Capacidad de formadores = 1
	~	persona/Week
	~	Parametro o constante. S.
	|

Tasa de retiro de promotores = 0.002
	~	1/Week
	~	Parametro o constante. S.
	|

Tasa base de cierre = 0.002
	~	1/Week
	~	Parametro o constante. S.
	|

Tiempo de manejo = 1
	~	Week
	~	Parametro o constante.
	|

Asistentes a feria = 200
	~	persona/Week
	~	Parametro o constante. S.
	|

kg por visita = 2
	~	kg/persona
	~	Parametro o constante. S.
	|

Precio mayorista base = 2500
	~	COP/kg
	~	Parametro o constante. S.
	|

Fraccion de reinversion a capacidad = 0.5
	~	Dmnl
	~	Parametro o constante. S.
	|

Fraccion de presupuesto a acopio = 0.1
	~	Dmnl
	~	Parametro o constante. S.
	|

Costo por kg semana de capacidad = 50000
	~	COP*Week/kg
	~	Parametro o constante. S.
	|

Depreciacion de equipamiento = 0.001
	~	1/Week
	~	Parametro o constante. S.
	|

Bass p = 0.00058
	~	1/Week
	~	Parametro o constante. Literatura Bass: 0,03 por anio. Por calibrar.
	|

Bass q = 0.0073
	~	1/Week
	~	Parametro o constante. Literatura Bass: 0,38 por anio. Por calibrar.
	|

Horas por m2 por semana = 0.1
	~	hora/m2/Week
	~	Parametro o constante. S.
	|

Horas disponibles por semana = 6
	~	hora/persona/Week
	~	Parametro o constante. S.
	|

h0 Retiro base = 0.005
	~	1/Week
	~	Parametro o constante. S.
	|

beta Sensibilidad a la carga = 1
	~	Dmnl
	~	Parametro o constante. S.
	|

Alivio por rotacion = 0.1
	~	Dmnl
	~	Parametro o constante. S.
	|

Encuentros por semana = 1
	~	1/Week
	~	Parametro o constante. S.
	|

Asistentes por encuentro = 20
	~	persona
	~	Parametro o constante. S.
	|

Calidad del encuentro = 0.8
	~	Dmnl
	~	Parametro o constante. S.
	|

Escala de formacion = 1000
	~	Dmnl
