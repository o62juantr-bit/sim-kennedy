{UTF-8}
Desgaste del equipamiento  = A FUNCTION OF( Tasa de desgaste del equipamiento) ~~|
Desgaste del equipamiento = Capacidad de acopio y reparto*Tasa de desgaste del equipamiento
	~	kg/Month/Month
	~		|

Merma en acopio  = A FUNCTION OF( Frecuencia de acopio,Frecuencia de acopio de referencia\
		,Tasa base de merma) ~~|
Merma en acopio = Producto en acopio*Tasa base de merma*Frecuencia de acopio de referencia\
		/Frecuencia de acopio
	~	kg/Month
	~	Acopiar más seguido reduce la merma. Lo que se daña va a compostaje.
	|

Compras locales  = A FUNCTION OF( Capacidad efectiva de reparto,Demanda de tiendas y comedores\
		,Producto en acopio,TIME STEP) ~~|
Compras locales = MIN(Demanda de tiendas y comedores,MIN(Capacidad efectiva de reparto\
		,MAX(0,Producto en acopio/TIME STEP
-Merma en acopio)))
	~	kg/Month
	~	Lo que compran tiendas y comedores a la red. Limitado por demanda, \
		capacidad y existencias.
	|

Maduración  = A FUNCTION OF( Tiempo de maduración) ~~|
Maduración = Orgánicos en estación de compostaje/Tiempo de maduración
	~	kg/Month
	~	Retardo entre orgánicos crudos y compost maduro.
	|

Agotamiento del suelo  = A FUNCTION OF( Tiempo de agotamiento del suelo) ~~|
Agotamiento del suelo = Fertilidad del suelo/Tiempo de agotamiento del suelo
	~	kg/Month
	~		|

Incorporación de participantes  = A FUNCTION OF( Participación comunitaria,Participantes objetivo\
		,Tiempo de incorporación) ~~|
Incorporación de participantes = Participación comunitaria*MAX(0,Participantes objetivo\
		-Participantes activos)/Tiempo de incorporación
	~	persona/Month
	~		|

Sustrato entregado al distrito  = A FUNCTION OF( Distrito biotecnológico activo,Fracción de orgánicos para sustrato\
		,Tiempo de entrega de sustrato) ~~|
Sustrato entregado al distrito = Orgánicos en estación de compostaje*Fracción de orgánicos para sustrato\
		/Tiempo de entrega de sustrato
*Distrito biotecnológico activo
	~	kg/Month
	~		|

Pérdida de conocimiento  = A FUNCTION OF( Tasa de olvido) ~~|
Pérdida de conocimiento = Conocimiento compartido*Tasa de olvido
	~	saber/Month
	~		|

Pérdida de proteína o hongos  = A FUNCTION OF( Tasa de pérdida de hongos) ~~|
Pérdida de proteína o hongos = Inventario de proteína y hongos*Tasa de pérdida de hongos
	~	kg/Month
	~		|

Autoconsumo  = A FUNCTION OF( Fracción de cosecha destinada al autoconsumo,Tiempo de salida de la cosecha\
		) ~~|
Autoconsumo = Cosecha disponible/Tiempo de salida de la cosecha*Fracción de cosecha destinada al autoconsumo
	~	kg/Month
	~		|

Retiro de promotores  = A FUNCTION OF( Tasa de retiro de promotores) ~~|
Retiro de promotores = Promotores formados y activos*Tasa de retiro de promotores
	~	persona/Month
	~		|

Retiro por desgaste  = A FUNCTION OF( Sobrecarga de participantes,Tasa base de desgaste de participantes\
		) ~~|
Retiro por desgaste = Participantes activos*Tasa base de desgaste de participantes*(1\
		+Sobrecarga de participantes)
	~	persona/Month
	~		|

Cierre o abandono de huertas  = A FUNCTION OF( -Factor de apoyo,Tasa base de cierre) ~~|
Cierre o abandono de huertas = Huertas activas*Tasa base de cierre*(1+(1-Factor de apoyo\
		))
	~	huerta/Month
	~	Cierran más si tienen poco conocimiento y pocos participantes por huerta.
	|

Compost entregado a huertas  = A FUNCTION OF( Tiempo de entrega de compost) ~~|
Compost entregado a huertas = Compost maduro/Tiempo de entrega de compost
	~	kg/Month
	~		|

Pérdidas en huerta  = A FUNCTION OF( Fracción de pérdidas en huerta,Tiempo de salida de la cosecha\
		) ~~|
Pérdidas en huerta = Cosecha disponible/Tiempo de salida de la cosecha*Fracción de pérdidas en huerta
	~	kg/Month
	~		|

Venta de proteína de hongos  = A FUNCTION OF( Demanda de proteína de hongos,-Pérdida de proteína o hongos\
		,TIME STEP) ~~|
Venta de proteína de hongos = MIN(Demanda de proteína de hongos,MAX(0,Inventario de proteína y hongos\
		/TIME STEP-Pérdida de proteína o hongos
))
	~	kg/Month
	~		|

Gasto en insumos y reinversión  = A FUNCTION OF( Tiempo de ejecución del gasto) ~~|
Gasto en insumos y reinversión = Ingreso acumulado por excedentes/Tiempo de ejecución del gasto
	~	COP/Month
	~		|

Huertas activas = INTEG(Apertura de huertas-Cierre o abandono de huertas,10)
	~	huerta
	~	Huertas en producción. Valor inicial: SUPUESTO.
	|

Cosecha disponible = INTEG(Producción de las huertas-Autoconsumo-Excedente entregado al acopio\
		-Pérdidas en huerta,100)
	~	kg
	~	Cosecha en la huerta antes de repartirse entre autoconsumo, venta y \
		pérdidas.
	|

Producto en acopio = INTEG(Excedente entregado al acopio-Compras locales-Venta directa en feria\
		-Merma en acopio,50)
	~	kg
	~	Excedente recibido por el equipo de acopio y reparto.
	|

Capacidad de acopio y reparto = INTEG(Ampliación de capacidad de acopio-Desgaste del equipamiento\
		,250)
	~	kg/Month
	~	Kilos por mes que el acopio puede mover. Valor inicial: SUPUESTO.
	|

Participantes activos = INTEG(Incorporación de participantes-Retiro por desgaste,25)
	~	persona
	~	Personas que participan en las huertas y la red.
	|

Ingreso acumulado por excedentes = INTEG(Ingreso por ventas-Gasto en insumos y reinversión\
		,0)
	~	COP
	~	Fondo de la red: ventas que aún no se han reinvertido.
	|

Conocimiento compartido = INTEG(Formación e intercambio-Pérdida de conocimiento,30)
	~	saber
	~	Índice de saberes (suelo, semillas, compost) circulando en la red. Unidad \
		ficticia: SUPUESTO.
	|

Orgánicos en estación de compostaje = INTEG(Orgánicos recibidos+Merma en acopio-Maduración\
		-Sustrato entregado al distrito,50)
	~	kg
	~	Orgánicos crudos. La merma del acopio vuelve aquí.
	|

Compost maduro = INTEG(Maduración-Compost entregado a huertas,0)
	~	kg
	~	Compost listo para entregar. Separado de los orgánicos crudos.
	|

Fertilidad del suelo = INTEG(Compost entregado a huertas-Agotamiento del suelo,150)
	~	kg
	~	Compost acumulado en el suelo de todas las huertas, en kilos equivalentes.
	|

Inventario de proteína y hongos = INTEG(Cosecha y procesamiento de hongos y proteína\
		-Venta de proteína de hongos-Pérdida de proteína o hongos,0)
	~	kg
	~		|

Presión sobre el humedal = INTEG(Actividad en el borde-Recuperación natural del humedal\
		,0.1)
	~	Dmnl
	~	Índice 0 a 1 o más. Sobre 1 el humedal está en riesgo. Escala: SUPUESTO.
	|

Promotores formados y activos = INTEG(Formación de promotores en Bavaria-Retiro de promotores\
		,2)
	~	persona
	~		|

Apertura de huertas = (Aperturas espontáneas+Promotores formados y activos*Huertas nuevas por promotor\
		)*Efecto del ingreso en la apertura*MAX(0,1-Huertas activas/Huertas potenciales)*Freno por humedal
	~	huerta/Month
	~	Los promotores formados en Bavaria abren huertas; el ingreso las atrae; el \
		suelo disponible y el humedal las frenan.
	|

Producción de las huertas = Huertas activas*Rendimiento por huerta*Efecto de la fertilidad\
		*Efecto del conocimiento en producción
	~	kg/Month
	~	Con cero huertas es cero. Viene de una nube; las huertas la influyen, no \
		la pierden.
	|

Excedente entregado al acopio = Cosecha disponible/Tiempo de salida de la cosecha*Fracción de cosecha destinada a la venta
	~	kg/Month
	~		|

Venta directa en feria = MIN(Demanda de feria,MAX(0,Producto en acopio/TIME STEP-Merma en acopio\
		-Compras locales))
	~	kg/Month
	~		|

Ampliación de capacidad de acopio = Gasto en insumos y reinversión*Fracción del gasto destinada a capacidad\
		/Costo de ampliar capacidad
	~	kg/Month/Month
	~	Cierra el circuito: lo que se vende se reinvierte en capacidad.
	|

Ingreso por ventas = (Compras locales+Venta directa en feria)*Precio de venta local+Venta de proteína de hongos\
		*Precio de la proteína de hongos
	~	COP/Month
	~		|

Orgánicos recibidos = Disponibilidad de residuos orgánicos*Frecuencia de recolección\
		/(Frecuencia de recolección+Frecuencia de media saturación de la recolección)
	~	kg/Month
	~	Recolectar más seguido captura más orgánicos, con rendimientos \
		decrecientes.
	|

Cosecha y procesamiento de hongos y proteína = Sustrato entregado al distrito*Rendimiento de hongos por kg de sustrato
	~	kg/Month
	~	Los hongos dependen del sustrato que llega del compostaje.
	|

Actividad en el borde = Huertas activas*Fracción de huertas en el borde*Presión por huerta de borde
	~	1/Month
	~	Solo las huertas del borde presionan el humedal.
	|

Recuperación natural del humedal = Presión sobre el humedal*Tasa de recuperación natural\
		*(1+Normativa ambiental de ronda)
	~	1/Month
	~	Una norma más estricta acelera la recuperación.
	|

Formación de promotores en Bavaria = MIN(Capacidad de formación,Candidatos disponibles\
		/Tiempo de formación de promotores)
	~	persona/Month
	~		|

Formación e intercambio = Promotores formados y activos*Conocimiento generado por promotor\
		+Participantes activos*Intercambio entre pares
	~	saber/Month
	~	Viene de una nube; promotores y participantes la influyen.
	|

Capacidad efectiva de reparto = Capacidad de acopio y reparto*MIN(1,Frecuencia de acopio\
		/Frecuencia de acopio de referencia)
	~	kg/Month
	~	La capacidad se aprovecha por completo solo si se acopia con la frecuencia \
		de referencia.
	|

Compras al mayorista = MAX(0,Demanda de tiendas y comedores-Compras locales)
	~	kg/Month
	~	Demanda que la red local no cubre y se sigue comprando a Corabastos.
	|

Dependencia del mayorista = ZIDZ(Compras al mayorista,Demanda de tiendas y comedores)
	~	Dmnl
	~	INDICADOR CENTRAL: 1 es depender por completo del mayorista, 0 es no \
		depender. Mide el objetivo general y el OE2.
	|

Efecto del ingreso en la apertura = 1+Sensibilidad de la apertura al ingreso*MIN(1,ZIDZ\
		(Ingreso por ventas,Huertas activas)/Ingreso de referencia por huerta)
	~	Dmnl
	~	Si cada huerta genera ingreso, más vecinos se animan a abrir la suya.
	|

Fertilidad por huerta = ZIDZ(Fertilidad del suelo,Huertas activas)
	~	kg/huerta
	~		|

Conocimiento por huerta = ZIDZ(Conocimiento compartido,Huertas activas)
	~	saber/huerta
	~	Baja cuando las huertas crecen más rápido que el conocimiento: \
		saturación del acompañamiento.
	|

Participantes por huerta = ZIDZ(Participantes activos,Huertas activas)
	~	persona/huerta
	~		|

Efecto de la fertilidad = Efecto mínimo de la fertilidad+(1-Efecto mínimo de la fertilidad\
		)*MIN(1,Fertilidad por huerta/Fertilidad de referencia por huerta)
	~	Dmnl
	~		|

Efecto del conocimiento en producción = 1+Aumento máximo de rendimiento por conocimiento\
		*MIN(1,Conocimiento por huerta/Conocimiento de referencia por huerta)
	~	Dmnl
	~	Aquí es donde Bavaria llega a las huertas: el conocimiento sube el \
		rendimiento.
	|

Factor de apoyo = (MIN(1,Conocimiento por huerta/Conocimiento de referencia por huerta\
		)+MIN(1,Participantes por huerta/Participantes de referencia por huerta))/2
	~	Dmnl
	~	0 a 1. Qué tan sostenida está cada huerta por saber y por personas.
	|

Fracción de cosecha destinada a la venta = 1-Fracción de cosecha destinada al autoconsumo\
		-Fracción de pérdidas en huerta
	~	Dmnl
	~	Autoconsumo, venta y pérdidas suman 1.
	|

Disponibilidad de residuos orgánicos = Residuos de hogares y comercios+Huertas activas\
		*Residuo propio por huerta
	~	kg/Month
	~		|

Freno por humedal = MAX(0,1-Normativa ambiental de ronda*Presión sobre el humedal/Presión crítica del humedal\
		)
	~	Dmnl
	~	Cuando la presión se acerca al nivel crítico, se frena la apertura de \
		huertas.
	|

Capacidad de formación = Formadores de Bavaria*Promotores formados por formador
	~	persona/Month
	~	Con cero formadores no hay promotores nuevos: es la simulación sin \
		Bavaria.
	|

Candidatos disponibles = MAX(0,Participantes activos*Fracción de participantes que pueden ser promotores\
		-Promotores formados y activos)
	~	persona
	~		|

Participantes objetivo = Huertas activas*Participantes objetivo por huerta
	~	persona
	~		|

Sobrecarga de participantes = MIN(3,MAX(0,ZIDZ(Huertas activas,Participantes activos)\
		/Carga tolerable por participante-1))
	~	Dmnl
	~	Si hay muchas huertas por persona, el desgaste sube.
	|

Normativa ambiental de ronda = 0.5
	~	Dmnl
	~	SUPUESTO por validar con datos de Kennedy. 0 sin norma, 1 norma estricta.
	|

Presión crítica del humedal = 1
	~	Dmnl
	~	SUPUESTO por validar con datos de Kennedy.
	|

