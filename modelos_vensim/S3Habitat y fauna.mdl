{UTF-8}
Mejora de calidad del parche  = A FUNCTION OF( Calidad objetivo del parche,Tiempo de ajuste de calidad\
		) ~~|
Mejora de calidad del parche = MAX(0,Calidad objetivo del parche-Calidad de parche)/Tiempo de ajuste de calidad
	~	1/Month
	~	Flujo. Ajuste hacia la calidad objetivo.
	|

Presion sobre el humedal  = A FUNCTION OF( Presion generada por el borde) ~~|
Presion sobre el humedal = INTEG(Presion generada por el borde - FLO16 Recuperacion del humedal\
		, 0.4)
	~	Dmnl
	~	Stock. Indice 0 a 1. Grafica G14. Bucle B3. Valor inicial 0,4 (S).
	|

Calidad de parche  = A FUNCTION OF( Mejora de calidad del parche) ~~|
Calidad de parche = INTEG(Mejora de calidad del parche - Deterioro de calidad del parche\
		, 0.6)
	~	Dmnl
	~	Stock. Recursos menos amenazas, promedio de parches.
	|

Ocupacion de parches por la especie clave  = A FUNCTION OF( Colonizacion de parches) ~~|
Ocupacion de parches por la especie clave = INTEG(Colonizacion de parches - Extincion local\
		, 0.5)
	~	Dmnl
	~	Stock. Fraccion p de parches ocupados (modelo de Levins). Individuos = p x \
		parches x aves por parche. Grafica G13.
	|

Mortalidad acumulada por trampas = INTEG(Muertes por trampas, 0)
	~	individuo
	~	Stock. Vidrio, luz y manejo de granos.
	|

Actividad en el borde = Huertas en el borde*Intensidad de uso por huerta*Norma de ronda efectiva
	~	hora/Month
	~	Auxiliar. Huertas E04 x intensidad de uso x norma efectiva. Se dibuja como \
		auxiliar; el flujo al stock es FLI17.
	|

Presion generada por el borde = ka Presion por hora persona*Actividad en el borde
	~	1/Month
	~	Flujo. ka x FLI09.
	|

Recuperacion del humedal = Presion sobre el humedal*kr Tasa de recuperacion del humedal
	~	1/Month
	~	Flujo. STK10 x tasa de recuperacion.
	|

Colonizacion de parches = c Tasa de colonizacion*Ocupacion de parches por la especie clave\
		*(1-Ocupacion de parches por la especie clave)
	~	1/Month
	~	Flujo. c x p x (1 - p), c = c0 x exp(-d/alfa).
	|

Extincion local = e Tasa de extincion*Ocupacion de parches por la especie clave
	~	1/Month
	~	Flujo. e0 x (1 + efecto trampa) x p.
	|

Deterioro de calidad del parche = MAX(0,Calidad de parche-Calidad objetivo del parche\
		)/Tiempo de ajuste de calidad
	~	1/Month
	~	Flujo.
	|

Muertes por trampas = Individuos de la especie clave*Mortalidad total por trampas/12
	~	individuo/Month
	~	Flujo. Individuos x mortalidad anual / 12.
	|

Norma de ronda efectiva = Norma ambiental de ronda*(1-MIN(1,MAX(0,Presion sobre el humedal\
		-Umbral de presion)/(1-Umbral de presion)))
	~	Dmnl
	~	Auxiliar. Cierra B3: mas presion, mas restricciones, menos uso del borde.
	|

Numero de parches = Parches naturales+Numero de huertas
	~	parche
	~	Auxiliar. Humedales El Burro, La Vaca y Techo mas huertas.
	|

Distancia efectiva entre parches = d Distancia base entre parches*(1-0.4*Corredores entre parches\
		)/(1+0.03*Numero de huertas)
	~	m
	~	Auxiliar. Los corredores y mas huertas acortan la distancia.
	|

c Tasa de colonizacion = c0 Colonizacion base*EXP(-Distancia efectiva entre parches/alfa Alcance de dispersion\
		)
	~	1/Month
	~	Auxiliar.
	|

e Tasa de extincion = e0 Extincion base*(1+Efecto de trampa)
	~	1/Month
	~	Auxiliar.
	|

Efecto de trampa = MIN(2,Riesgo de trampa ecologica*Factor de escala de trampa)
	~	Dmnl
	~	Auxiliar.
	|

m vidrio = Intensidad de vidrio*Coeficiente de mortalidad por vidrio*(1-Efectividad de la medida antitrampa\
		*Medida antitrampa)
	~	1/Year
	~	Auxiliar. Mortalidad por vidrio.
	|

m luz = Intensidad de luz nocturna*Coeficiente de mortalidad por luz*(1-Efectividad de la medida antitrampa\
		*Medida antitrampa)
	~	1/Year
	~	Auxiliar. Mortalidad por luz nocturna.
	|

m grano = Granos expuestos*Coeficiente de mortalidad por granos*(1-Efectividad de la medida antitrampa\
		*Medida antitrampa)*MIN(1,Numero de huertas)
	~	1/Year
	~	Auxiliar. Mortalidad por granos expuestos en huertas.
	|

Mortalidad total por trampas = m vidrio+m luz+m grano
	~	1/Year
	~	Auxiliar. Grafica G16.
	|

Recursos del parche = 0.3+0.4*Densidad de arboles+0.1*MIN(1,Numero de huertas/10)
	~	Dmnl
	~	Auxiliar.
	|

Calidad objetivo del parche = MAX(0,MIN(1,Recursos del parche-2*Mortalidad total por trampas\
		-0.3*Presion sobre el humedal))
	~	Dmnl
	~	Auxiliar. Recursos menos amenazas.
	|

Individuos de la especie clave = Ocupacion de parches por la especie clave*Numero de parches\
		*Aves por parche
	~	individuo
	~	Auxiliar.
	|

Conectividad = 1/(1+(Distancia efectiva entre parches/alfa Alcance de dispersion)^4)
	~	Dmnl
	~	Auxiliar. Grafica G15. Aproximacion agregada de parches con vecino a menos \
		de alfa.
	|

Riesgo de trampa ecologica = Calidad de parche*Mortalidad total por trampas
	~	Dmnl
	~	Auxiliar. Grafica G16. Calidad atractiva x mortalidad.
	|

Ocupacion de equilibrio = MAX(0,1-e Tasa de extincion/c Tasa de colonizacion)
	~	Dmnl
	~	Reportero de grafica. Grafica G13. p* = max(0, 1 - e/c).
	|

Equilibrio de presion = ka Presion por hora persona*Actividad en el borde/kr Tasa de recuperacion del humedal
	~	Dmnl
	~	Reportero de grafica. Grafica G14.
	|

Horas persona admisibles = Umbral de presion*kr Tasa de recuperacion del humedal/ka Presion por hora persona
	~	hora/Month
	~	Reportero de grafica. Grafica G14. Con los valores de ejemplo, 80 horas al \
		mes.
	|

Escenario S3 = 2
	~	Dmnl
	~	Parametro o constante. 1 = sin huertas, 2 = huertas sin criterio de \
		ubicacion, 3 = huertas con corredores.
	|

Medida antitrampa = 0
	~	Dmnl
	~	Parametro o constante. 0 = no, 1 = si (cintas en vidrios, apagar luz, \
		manejo de granos).
	|

Numero de huertas = IF THEN ELSE(Escenario S3=1,0,12)
	~	Dmnl
	~	Parametro o constante. S.
	|

Huertas en el borde = IF THEN ELSE(Escenario S3=1,0,IF THEN ELSE(Escenario S3=2,12,4)\
		)
	~	Dmnl
	~	Parametro o constante. S.
	|

Corredores entre parches = IF THEN ELSE(Escenario S3=3,1,0)
	~	Dmnl
	~	Parametro o constante.
	|

Intensidad de uso por huerta = 10
	~	hora/Month
	~	Parametro o constante. Por estimar.
	|

Norma ambiental de ronda = 1
	~	Dmnl
	~	Parametro o constante. 1 = permite cultivar en E04, 0 = no. Por verificar.
	|

ka Presion por hora persona = 0.0005
	~	1/hora
	~	Parametro o constante. Por estimar.
	|

kr Tasa de recuperacion del humedal = 0.1
	~	1/Month
	~	Parametro o constante. Por estimar.
	|

Umbral de presion = 0.4
	~	Dmnl
	~	Parametro o constante.
	|

Densidad de arboles = 0.5
	~	Dmnl
	~	Parametro o constante. Slider.
	|

Intensidad de vidrio = 0.3
	~	Dmnl
	~	Parametro o constante. Slider. Por edificio.
	|

Intensidad de luz nocturna = 0.3
	~	Dmnl
	~	Parametro o constante. Slider.
	|

Granos expuestos = 0.3
	~	Dmnl
	~	Parametro o constante. Slider.
	|

Coeficiente de mortalidad por vidrio = 0.1
	~	1/Year
	~	Parametro o constante. S.
	|

Coeficiente de mortalidad por luz = 0.08
	~	1/Year
	~	Parametro o constante. S.
	|

Coeficiente de mortalidad por granos = 0.1
	~	1/Year
	~	Parametro o constante. S.
	|

Efectividad de la medida antitrampa = 0.8
	~	Dmnl
	~	Parametro o constante. S.
	|

alfa Alcance de dispersion = 500
	~	m
	~	Parametro o constante. Por especie. Validar con especialista.
	|

d Distancia base entre parches = 500
	~	m
	~	Parametro o constante. Medir en el mapa.
	|

c0 Colonizacion base = 0.4/12
	~	1/Month
	~	Parametro o constante. 0,4 por anio (S).
	|

e0 Extincion base = 0.1/12
	~	1/Month
	~	Parametro o constante. 0,1 por anio (S).
	|

Aves por parche = 4
	~	individuo
	~	Parametro o constante. S.
	|

Parches naturales = 3
	~	parche
	~	Parametro o constante. Humedales El Burro, La Vaca y Techo.
	|

Tiempo de ajuste de calidad = 6
	~	Month
	~	Parametro o constante. S.
	|

Factor de escala de trampa = 10
	~	Dmnl
	~	Parametro o constante. S.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 120
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Month [0,?]
	~	The time step for the simulation.
	|

